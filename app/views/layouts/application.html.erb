<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Wikibed (archive) — Joshua Zapata</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="2016 archive demonstration: collaborative public and private wiki pages in Rails. Not a production product. Built by Joshua Zapata.">
  <meta name="author" content="Joshua Zapata">
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="https://github.com/joshuazap/wikibed">
  <meta property="og:title" content="Wikibed (archive) — Joshua Zapata">
  <meta property="og:description" content="2016 Rails wiki demonstration. Career/portfolio archive only.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://github.com/joshuazap/wikibed">
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css" integrity="sha384-1q8mTJOASx8j1Au+a5WDVnPi2lkFfwwEAa8hDDdjZlpLegxhjVME1fgjWPGmkzs7" crossorigin="anonymous">
  <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track' => true %>
  <%= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
  <%= csrf_meta_tags %>
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"SoftwareSourceCode","name":"Wikibed","description":"Archive demonstration of a Rails wiki with private pages and collaborators.","codeRepository":"https://github.com/joshuazap/wikibed","programmingLanguage":"Ruby","author":{"@type":"Person","name":"Joshua Zapata","url":"https://zapatas.org"}}
  </script>
</head>

<body>
  <aside class="archive-banner" role="note">
    <strong>Archive demonstration (2016).</strong>
    Not a production product.
    <a href="https://zapatas.org">Joshua Zapata / Zapatas</a>
    ·
    <a href="https://github.com/joshuazap/wikibed">Source on GitHub</a>
  </aside>
  <nav class="navbar navbar-inverse navbar-static-top" role="navigation">
    <div class="container">
      <div class="navbar-header">
        <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
        <%= link_to "Wikibed", root_path, :class => 'navbar-brand' %>
      </div>
      <div id="navbar" class="collapse navbar-collapse">
        <ul class="nav navbar-nav">
          <li class="active"><%= link_to "Home", root_path, :class => 'navbar-link' %></li>
          <li><a href="https://zapatas.org">Zapatas</a></li>
          <% if user_signed_in? %>
          <div class="user-info">
            <% if current_user.subscribed? %>
              <li><%= link_to "Premium", edit_user_registration_path, :class => 'navbar-link' %></li>
            <% else %>
              <li><%= link_to "Unlock Premium Features", new_charge_path, :class => 'navbar-link' %></li>
            <% end %>
              <li><%= link_to 'Edit Profile', edit_user_registration_path, :class => 'navbar-link' %></li>
              <li><%= link_to 'Sign Out', destroy_user_session_path, method: :delete, :class => 'navbar-link' %></li>
            <% else %>
              <li><%= link_to "Sign Up", new_user_registration_path, :class => 'navbar-link' %></li>
              <li><%= link_to "Sign In", new_user_session_path, :class => 'navbar-link' %></li>
            <% end %>
          </div>
        </ul>
      </div><!--/.nav-collapse -->
    </div>
  </nav>
  <div class="flash">
    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>
  </div>

  <%= yield %>
  <a href="#" class="back-to-top"></a>
<script src="https://code.jquery.com/jquery-1.12.4.min.js" integrity="sha256-ZosEbRLbNQzLpnKIkEdrPv7lOy9C27hHQ+Xp8a4MxAQ=" crossorigin="anonymous"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/js/bootstrap.min.js" integrity="sha384-0mSbJDEHialfmuBBQP6A4Qrprq5OVfW37PRR3j5ELqxss1yVqOtnepnHVP9aJ7xS" crossorigin="anonymous"></script>
</body>
</html>
